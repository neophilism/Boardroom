# Private production-only .env. Create this on the VM, chmod 600, and
# replace every placeholder. Never commit the actual .env file.
BOARDROOM_IMAGE=ghcr.io/neophilism/boardroom:sha-REPLACE_WITH_40_CHAR_SHA
BOARDROOM_HOSTNAME=boardroom.your-domain.example
ACME_EMAIL=private-admin-email@example.com
DATABASE_URL=postgresql://REPLACE_WITH_EXISTING_NEON_POOLER_URL
BOARDROOM_TOKEN_PEPPER=REPLACE_WITH_EXISTING_32_CHAR_OR_LONGER_SECRET
BOARDROOM_OWNER_API_TOKEN=REPLACE_WITH_EXISTING_32_CHAR_OR_LONGER_SECRET
BOARDROOM_SESSION_SECRET=REPLACE_WITH_EXISTING_32_CHAR_OR_LONGER_SECRET
BOARDROOM_GITHUB_APP_ID=
BOARDROOM_GITHUB_INSTALLATION_ID=
BOARDROOM_GITHUB_APP_PRIVATE_KEY=
BOARDROOM_GITHUB_OWNER=neophilism
BOARDROOM_GITHUB_WEBHOOK_SECRET=
BOARDROOM_OAUTH_ENABLED=false
BOARDROOM_DAILY_COST_CAP_MICROUSD=0
