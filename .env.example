# Required for API database operations once the DB-backed endpoints are enabled.
# Never commit actual credentials. Configure in the Render environment instead.
DATABASE_URL=
# Optional migration-only connection with additional schema privileges:
DATABASE_URL_MIGRATIONS=

# Initial privileged owner API access; store exclusively in the server secret manager.
BOARDROOM_OWNER_API_TOKEN=
BOARDROOM_TOKEN_PEPPER=

BOARDROOM_SESSION_SECRET=

# GitHub App installation access. Never commit real values.
BOARDROOM_GITHUB_APP_ID=
BOARDROOM_GITHUB_INSTALLATION_ID=
BOARDROOM_GITHUB_APP_PRIVATE_KEY=
BOARDROOM_GITHUB_OWNER=neophilism
